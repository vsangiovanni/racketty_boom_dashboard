# --- Entornos ---
# Local: la app carga backend/.env (este archivo es plantilla). Mantén NODE_ENV=development o sin definir.
# Produccion (NODE_ENV=production): se cargan, sin pisar variables ya definidas en el panel,
# backend/.env.produccion, luego backend/.env.production, luego backend/.env si existen en el servidor.
# Hostinger: suele bastar con definir variables en el panel Node.js; o sube .env.production con File Manager
# y empaqueta el deploy con: pack-hostinger.ps1 -IncludeProductionEnv (no subas ese zip a sitios publicos).
#
# App
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# MySQL (o una sola URL; si DATABASE_URL esta definida, se ignora el bloque DB_*)
# DATABASE_URL=mysql://user:password@localhost:3306/greg_tracker
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=greg_tracker
# Alias opcionales (algunos hosts): MYSQL_HOST, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Vision AI Provider: openai | gemini
VISION_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_key
OPENAI_VISION_MODEL=gpt-4.1-mini

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_VISION_MODEL=gemini-2.0-flash

# Quote request email — Hostinger: saliente SMTP (panel "Set up email on your device")
# Copia estas lineas a .env / .env.production (no subas contrasenas a Git). Sin SMTP el lead se guarda igual.
# Varias direcciones: separadas por coma o punto y coma (misma notificacion interna a todas).
QUOTE_NOTIFY_TO=victorsangiovanni@gmail.com,gregorybarneswatson@gmail.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=info@racketty.vmsencf.com
SMTP_PASS=your_mailbox_password
SMTP_FROM=info@racketty.vmsencf.com
# Opcional: nombre visible en el remitente (mejor entregabilidad que solo el email)
SMTP_FROM_NAME=Racketty Boom Enterprises
